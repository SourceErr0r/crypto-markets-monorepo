# Copy to .env.local. Not a secret: EXPO_PUBLIC_* values are inlined into the app.
# The CoinGecko key lives in the API proxy (apps/proxy/.dev.vars), never here.
#
# Where the API proxy runs. Leave empty for local development: the app uses
# `pnpm proxy` on this machine (localhost for iOS simulator and
# web, 10.0.2.2 for the Android emulator). Setting it overrides every platform.
# Physical device: http://<your-LAN-IP>:8787, and start the proxy with
# `pnpm proxy --ip 0.0.0.0`.
EXPO_PUBLIC_API_BASE_URL=
