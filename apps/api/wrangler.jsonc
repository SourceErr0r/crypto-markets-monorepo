// Watchlist API: the apps' own backend (users, watchlist, preferences).
// Contract: docs/watchlist-api.md.
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crypto-markets-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The proxy uses 8787 locally.
  "dev": { "port": 8788 },

  // No database_id: Wrangler creates the database on first deploy, and
  // `wrangler dev` uses a local SQLite file under .wrangler/.
  // Schema changes are files in migrations/ (`pnpm db:migrate` applies them).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crypto-markets-api",
      "migrations_dir": "migrations"
    }
  ],

  // Counts are per Cloudflare location and approximate. Period must be 10 or
  // 60 seconds. namespace_id must be unique in the account (the proxy uses 1001).
  "ratelimits": [
    // POST /v1/user, keyed by client IP.
    { "name": "USER_CREATION_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // Every other route, keyed by user id.
    { "name": "USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ]
}
